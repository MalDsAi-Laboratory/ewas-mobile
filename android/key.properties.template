# Copy this file to android/key.properties and fill in the real values.
# NEVER commit key.properties — it is gitignored.
# Generate a keystore: keytool -genkey -v -keystore scrapit.jks -alias scrapit -keyalg RSA -keysize 2048 -validity 10000
storePassword=<keystore-password>
keyPassword=<key-password>
keyAlias=scrapit
storeFile=<absolute-path-to-scrapit.jks>
